+# Read only the requested posting. No application endpoint, POST, redirect,
+# employer navigation, cookie export or credentials in the returned value.
+APPLY_RECORD_JS = r"""async (jobId) => {
+    if (!/^\d+$/.test(jobId) || location.pathname.replace(/\/+$/, '') !== '/jobs/view/' + jobId) return null;
+    const csrf = document.cookie.split('; ').find(c => c.startsWith('JSESSIONID='))
+        ?.slice('JSESSIONID='.length).replace(/^"|"$/g, '');
+    if (!csrf) return null;
+    try {
+        const response = await fetch('/voyager/api/jobs/jobPostings/' + jobId, {
+            method: 'GET', credentials: 'same-origin', mode: 'same-origin', redirect: 'error',
+            headers: {'csrf-token': csrf, 'accept': 'application/json'},
+            signal: AbortSignal.timeout(10000),
+        });
+        if (!response.ok) return null;
+        const data = await response.json();
+        if (data.entityUrn !== 'urn:li:fs_normalized_jobPosting:' + jobId) return null;
+        const info = data.applyingInfo;
+        if (info?.entityUrn !== 'urn:li:fs_jobApplyingInfo:' + jobId
+            || typeof info.applied !== 'boolean' || typeof info.closed !== 'boolean') return null;
+        const href = data.applyMethod?.['com.linkedin.voyager.jobs.OffsiteApply']?.companyApplyUrl;
+        return {applied: info.applied, closed: info.closed,
+                url: typeof href === 'string' ? href : null};
+    } catch (error) { return null; }
+}"""
